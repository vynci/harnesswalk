{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiharness.vynci.dev/spec/0.1/events.schema.json",
  "title": "harnesswalk harness event",
  "description": "One event in the harness event stream. The stream is the single source for the UI, the trace store, step mode and replay. Ordering and pairing rules that span several events are normative in spec/events.md and are checked by the conformance suite, not by this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "seq",
    "ts",
    "trace_id",
    "turn_id",
    "session_id",
    "tenant_id",
    "type",
    "status"
  ],
  "properties": {
    "schema_version": {
      "description": "Version of this schema the event conforms to.",
      "const": "0.1.0"
    },
    "event_id": {
      "description": "Unique within the trace. SHOULD be a UUIDv7 or ULID so ids sort by time.",
      "$ref": "#/$defs/token"
    },
    "seq": {
      "description": "Position in the turn. 0 on turn_start, then +1 per event with no gaps.",
      "type": "integer",
      "minimum": 0
    },
    "ts": {
      "description": "RFC 3339 timestamp with an explicit offset. SHOULD be UTC with a Z suffix.",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "trace_id": {
      "description": "W3C trace id: 32 lowercase hex characters, not all zero. One per turn.",
      "type": "string",
      "pattern": "^(?!0{32})[0-9a-f]{32}$"
    },
    "turn_id": {
      "description": "Turn id. Null only on ops events (spec/events.md section 10, P4), which belong to no turn.",
      "anyOf": [{ "$ref": "#/$defs/token" }, { "type": "null" }]
    },
    "session_id": {
      "description": "Session id. Null only on ops events (spec/events.md section 10, P4).",
      "anyOf": [{ "$ref": "#/$defs/token" }, { "type": "null" }]
    },
    "tenant_id": {
      "description": "Required on every event. Consumers MUST NOT show an event to a viewer of another tenant.",
      "$ref": "#/$defs/token"
    },
    "type": {
      "enum": [
        "turn_start",
        "turn_end",
        "node_enter",
        "node_exit",
        "node_paused",
        "node_resumed",
        "edge",
        "approval_requested",
        "approval_decided",
        "memory_proposed",
        "memory_written",
        "artifact_released",
        "message_delta",
        "error",
        "eval_run_started",
        "eval_case_finished",
        "eval_run_finished",
        "feedback_recorded",
        "artifact_changed"
      ]
    },
    "node_id": {
      "description": "A node id from spec/diagram/diagram.json. Simple or expert.",
      "$ref": "#/$defs/node_id"
    },
    "edge_id": {
      "description": "An edge id from spec/diagram/diagram.json. Required on edge events, absent otherwise.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,127}$"
    },
    "status": { "enum": ["active", "waiting", "done", "error", "skipped"] },
    "duration_ms": {
      "description": "Wall-clock time since the matching node_enter (node_exit, error) or turn_start (turn_end). Paused time is included.",
      "type": "number",
      "minimum": 0
    },
    "summary": {
      "description": "Small, redacted payload for the UI. Shape per node and type is documented in spec/events.md. SHOULD serialize to at most 2 KiB.",
      "type": "object",
      "maxProperties": 24
    },
    "detail_ref": {
      "description": "Pointer to the full record in the trace store, for example trace://<trace_id>/<event_id>.",
      "type": ["string", "null"],
      "pattern": "^[a-z][a-z0-9+.-]*://"
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "usd"],
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "usd": { "type": "number", "minimum": 0 }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z][a-z0-9_.]{0,63}$" },
        "message": { "type": "string", "maxLength": 1000 }
      }
    },
    "ext": {
      "description": "Implementation-specific fields. Consumers MUST ignore what they do not understand. Conformance never asserts on it.",
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "eval_run_started",
              "eval_case_finished",
              "eval_run_finished",
              "feedback_recorded",
              "artifact_changed",
              "artifact_released"
            ]
          }
        }
      },
      "else": { "properties": { "turn_id": { "type": "string" }, "session_id": { "type": "string" } } }
    },
    {
      "if": { "properties": { "type": { "const": "turn_start" } } },
      "then": {
        "properties": { "status": { "const": "active" }, "seq": { "const": 0 } },
        "not": { "anyOf": [{ "required": ["node_id"] }, { "required": ["edge_id"] }] }
      }
    },
    {
      "if": { "properties": { "type": { "const": "turn_end" } } },
      "then": {
        "required": ["duration_ms"],
        "properties": { "status": { "enum": ["done", "error"] } },
        "not": { "anyOf": [{ "required": ["node_id"] }, { "required": ["edge_id"] }] }
      }
    },
    {
      "if": { "properties": { "type": { "const": "node_enter" } } },
      "then": { "required": ["node_id"], "properties": { "status": { "const": "active" } } }
    },
    {
      "if": { "properties": { "type": { "const": "node_exit" } } },
      "then": {
        "required": ["node_id", "duration_ms"],
        "properties": { "status": { "enum": ["done", "skipped"] } }
      }
    },
    {
      "if": { "properties": { "type": { "const": "node_paused" } } },
      "then": {
        "required": ["node_id", "summary"],
        "properties": {
          "status": { "const": "waiting" },
          "summary": {
            "required": ["reason"],
            "properties": { "reason": { "enum": ["breakpoint", "approval"] } }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "node_resumed" } } },
      "then": { "required": ["node_id"], "properties": { "status": { "const": "active" } } }
    },
    {
      "if": { "properties": { "type": { "const": "edge" } } },
      "then": {
        "required": ["edge_id"],
        "properties": { "status": { "const": "done" } },
        "not": { "required": ["node_id"] }
      },
      "else": { "not": { "required": ["edge_id"] } }
    },
    {
      "if": { "properties": { "type": { "const": "approval_requested" } } },
      "then": {
        "required": ["node_id", "summary"],
        "properties": {
          "node_id": { "const": "approval" },
          "status": { "const": "waiting" },
          "summary": { "required": ["approval_id", "tool", "action_class"] }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "approval_decided" } } },
      "then": {
        "required": ["node_id", "summary"],
        "properties": {
          "node_id": { "const": "approval" },
          "status": { "const": "done" },
          "summary": {
            "required": ["approval_id", "decision"],
            "properties": { "decision": { "enum": ["approve", "deny", "expired"] } }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "memory_proposed" } } },
      "then": {
        "required": ["node_id", "summary"],
        "properties": {
          "node_id": { "const": "memory_writer" },
          "status": { "const": "waiting" },
          "summary": { "required": ["proposal_id", "store"] }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "memory_written" } } },
      "then": {
        "required": ["node_id", "summary"],
        "properties": {
          "node_id": { "const": "memory_writer" },
          "status": { "const": "done" },
          "summary": { "required": ["proposal_id", "store", "record_id"] }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "artifact_released" } } },
      "then": {
        "required": ["node_id", "summary"],
        "properties": {
          "node_id": { "const": "release" },
          "status": { "const": "done" },
          "summary": {
            "anyOf": [{ "required": ["artifact", "version"] }, { "required": ["release_id", "artifacts"] }]
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "eval_run_started" } } },
      "then": {
        "required": ["node_id", "summary"],
        "properties": {
          "node_id": { "const": "eval" },
          "status": { "const": "active" },
          "summary": { "required": ["run_id"] }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "eval_case_finished" } } },
      "then": {
        "required": ["node_id", "summary"],
        "properties": {
          "node_id": { "const": "eval" },
          "status": { "const": "done" },
          "summary": {
            "required": ["run_id", "case_id", "status"],
            "properties": { "status": { "enum": ["passed", "failed", "skipped", "error"] } }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "eval_run_finished" } } },
      "then": {
        "required": ["node_id", "summary"],
        "properties": {
          "node_id": { "const": "eval" },
          "status": { "enum": ["done", "error"] },
          "summary": { "required": ["run_id"] }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "feedback_recorded" } } },
      "then": {
        "required": ["node_id", "summary"],
        "properties": {
          "turn_id": { "type": "string" },
          "session_id": { "type": "string" },
          "node_id": { "const": "eval" },
          "status": { "const": "done" },
          "summary": {
            "required": ["rating"],
            "properties": { "rating": { "enum": ["good", "bad"] } }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "artifact_changed" } } },
      "then": {
        "required": ["node_id", "summary"],
        "properties": {
          "node_id": { "const": "release" },
          "status": { "const": "done" },
          "summary": { "required": ["kind", "name", "version"] }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "message_delta" } } },
      "then": {
        "required": ["node_id", "summary"],
        "properties": {
          "node_id": { "const": "gateway" },
          "status": { "const": "active" },
          "summary": {
            "required": ["delta", "index"],
            "properties": {
              "delta": { "type": "string" },
              "index": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "error" } } },
      "then": { "required": ["error"], "properties": { "status": { "const": "error" } } },
      "else": { "not": { "required": ["error"] } }
    }
  ],
  "$defs": {
    "token": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$" },
    "node_id": {
      "enum": [
        "gateway",
        "input_guardrails",
        "policy",
        "approval",
        "audit",
        "context_builder",
        "memory",
        "procedural",
        "session",
        "semantic",
        "episodic",
        "knowledge",
        "memory_writer",
        "loop",
        "model_layer",
        "router",
        "providers",
        "tools",
        "registry",
        "sandbox",
        "output_guardrails",
        "trace",
        "cost",
        "eval",
        "online_eval",
        "offline_eval",
        "diagnose",
        "release",
        "artifacts"
      ]
    }
  }
}
