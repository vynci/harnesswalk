{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiharness.vynci.dev/spec/0.1/conformance/fixture.schema.json",
  "title": "harnesswalk fake-provider fixture",
  "description": "Scripted responses for the fake model provider. Semantics in spec/contracts/model_provider.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["fixture", "turns"],
  "properties": {
    "fixture": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
    "description": { "type": "string" },
    "model": { "type": "string", "default": "fake-small" },
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["responses"],
        "properties": {
          "responses": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/response" }
          }
        }
      }
    }
  },
  "$defs": {
    "response": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [{ "required": ["text"] }, { "required": ["tool_calls"] }],
      "properties": {
        "text": { "type": "string" },
        "tool_calls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "arguments"],
            "properties": {
              "call_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
              "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
              "arguments": { "type": "object" }
            }
          }
        },
        "finish_reason": { "enum": ["stop", "tool_calls", "length"] },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "input_tokens": { "type": "integer", "minimum": 0 },
            "output_tokens": { "type": "integer", "minimum": 0 },
            "cached_tokens": { "type": "integer", "minimum": 0 }
          }
        },
        "latency_ms": { "type": "integer", "minimum": 0 },
        "expect": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tools_enabled": { "type": "boolean" },
            "last_message_role": { "enum": ["system", "user", "assistant", "tool"] },
            "last_message_contains": { "type": "string" },
            "system_contains": { "type": "string" }
          }
        }
      }
    }
  }
}
