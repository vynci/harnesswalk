{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnesswalk.vynci.dev/spec/0.1/conformance/case.schema.json",
  "title": "harnesswalk conformance case",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "spec_version", "fixture", "turns"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
    "title": { "type": "string", "minLength": 1 },
    "spec_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "fixture": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
    "mode": {
      "description": "The mode the harness starts in for this case. In public mode the tenant is the anonymous cookie tenant, not the tenant header.",
      "enum": ["dev", "public", "private"],
      "default": "dev"
    },
    "two_process": {
      "description": "P3: the runner runs the harness as an OS process so a `restart` action can kill it and start a new one on the same data directory.",
      "type": "boolean"
    },
    "config": {
      "description": "Overrides of profile keys. Only keys listed in profile.yaml `overridable` are allowed.",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" }
    },
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/turn" }
    }
  },
  "$defs": {
    "matcher": {
      "description": "Matches an event when every given key equals the event's value. `summary` matches as a recursive subset: objects by key, scalars and arrays by equality.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "type": { "type": "string" },
        "node_id": { "type": "string" },
        "edge_id": { "type": "string" },
        "status": { "enum": ["active", "waiting", "done", "error", "skipped"] },
        "summary": { "type": "object" },
        "error": { "type": "object" }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["when", "do"],
      "properties": {
        "when": { "$ref": "#/$defs/matcher" },
        "do": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "maxProperties": 1,
          "properties": {
            "approval": { "enum": ["approve", "deny"] },
            "resume": { "enum": ["step", "continue", "step_over"] },
            "cancel": { "const": true },
            "restart": { "const": true }
          }
        },
        "repeat": { "type": "boolean", "default": false }
      }
    },
    "request": {
      "description": "P4: one HTTP request the runner makes before or after a turn. Strings may name saved values as ${name}.",
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path"],
      "properties": {
        "method": { "enum": ["GET", "POST", "PUT"] },
        "path": { "type": "string", "pattern": "^/" },
        "body": { "type": "object" },
        "status": { "type": "integer", "default": 200 },
        "match": { "type": "object", "description": "Recursive subset the JSON response must match." },
        "save": {
          "description": "Values to keep for later requests and turns: name -> dotted path into the JSON response.",
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "wait": {
          "description": "Repeat the request until status and match hold, at most this many seconds.",
          "type": "object",
          "additionalProperties": false,
          "required": ["timeout_s"],
          "properties": { "timeout_s": { "type": "number", "minimum": 0 } }
        }
      }
    },
    "turn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["send", "expect"],
      "properties": {
        "before": {
          "description": "P4: requests made, in order, before the turn's message is sent.",
          "type": "array",
          "items": { "$ref": "#/$defs/request" }
        },
        "after": {
          "description": "P4: requests made, in order, after the turn ends and its http checks ran.",
          "type": "array",
          "items": { "$ref": "#/$defs/request" }
        },
        "send": {
          "type": "object",
          "additionalProperties": false,
          "required": ["message"],
          "properties": {
            "message": { "type": "string", "minLength": 1 },
            "options": { "type": "object" },
            "session_id": {
              "description": "P5: send this turn in this session (usually a ${name} saved from POST /v1/sessions) instead of the case's running session; the running session becomes this one.",
              "type": "string",
              "minLength": 1
            }
          }
        },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
        "http": {
          "description": "P3: GET requests made after the turn ends; each response must have `status` (default 200) and its JSON must match `match` as a recursive subset.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["get"],
            "properties": {
              "get": { "type": "string", "pattern": "^/" },
              "status": { "type": "integer" },
              "match": { "type": "object" }
            }
          }
        },
        "expect": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path"],
          "properties": {
            "path": {
              "description": "Exact simple-view node path: node_id of each node_enter whose node is a simple node, in seq order.",
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" }
            },
            "statuses": {
              "description": "Status of the event that closed each path entry. A single value applies to every entry.",
              "oneOf": [
                { "enum": ["done", "skipped", "error"] },
                { "type": "array", "items": { "enum": ["done", "skipped", "error"] } }
              ]
            },
            "events": {
              "description": "Ordered subsequence: matchers must match distinct events in this order, greedily.",
              "type": "array",
              "items": { "$ref": "#/$defs/matcher" }
            },
            "absent": {
              "description": "No event in the turn may match any of these.",
              "type": "array",
              "items": { "$ref": "#/$defs/matcher" }
            },
            "cost": {
              "description": "Exact token totals on turn_end.cost.",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "input_tokens": { "type": "integer", "minimum": 0 },
                "output_tokens": { "type": "integer", "minimum": 0 }
              }
            },
            "reply_contains": {
              "description": "Substrings of turn_end.summary.reply, case-sensitive.",
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
