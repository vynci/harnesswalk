# Copy to .env for local overrides. Never commit .env. Leave keys empty unless you need them.
# Mode: dev | public | private
HARNESSWALK_MODE=dev
# Model provider for the loop: fake | ollama | anthropic | openai_compatible
HARNESSWALK_PROVIDER=ollama
HARNESSWALK_OLLAMA_URL=
# Fake provider fixture name (only with HARNESSWALK_PROVIDER=fake)
HARNESSWALK_FIXTURE=
# Where SQLite stores live (default ./data)
HARNESSWALK_DATA_DIR=
# The built web app the API serves at / (default ./web/dist, built by make web-build)
HARNESSWALK_WEB_DIST=
# Signs the public-mode tenant cookie. Unset means a random key per process.
HARNESSWALK_SECRET=
# Hosted provider keys (optional, P3). Prefer shell env vars over this file.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Local Postgres (compose). Override for anything that is not your own laptop.
POSTGRES_PASSWORD=
