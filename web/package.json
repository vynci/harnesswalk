{
  "name": "harnesswalk-web",
  "private": true,
  "version": "0.2.0",
  "description": "harnesswalk web UI: chat plus a live harness diagram driven by the event stream.",
  "license": "Apache-2.0",
  "author": "Vince Elizaga <hello@vynci.dev>",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "VITE_HARNESSWALK_MOCK=1 vite",
    "build": "tsc -b && vite build",
    "build:mock": "tsc -b && VITE_HARNESSWALK_MOCK=1 vite build --outDir dist-mock",
    "build:e2e": "tsc -b && VITE_HARNESSWALK_VALIDATE=1 vite build --outDir dist-e2e",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings 0 && tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test --config playwright.live.config.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.3",
    "@shadcn/react": "0.3.1",
    "@xyflow/react": "12.12.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "highlight.js": "11.12.0",
    "lucide-react": "1.64.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.15.1",
    "remark-gfm": "4.0.1",
    "shiki": "4.5.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "yaml": "2.9.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
